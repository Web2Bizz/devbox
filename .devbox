# .devbox-project — тег проекта для Trello-задач (task-manager pipeline, ранее .trello-project).
# Сгенерировано scripts/task-manager/init.sh. Без секретов — можно коммитить.
# BOARD/LIST — дефолтные доска/лист (точные имена); запоминаются через create.sh --save-defaults.
NAME=Web2Bizz/devbox-backend
PROFILE_MONOREPO=yes
PROFILE_MICROSERVICES=yes
PROFILE_FRONTEND=react
PROFILE_BACKEND=node
PROFILE_DATABASE=postgres
PROFILE_TYPE=mvp
PROFILE_COMMIT_MODE=batch
PROFILE_APPS_DIR=apps
