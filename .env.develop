# Build-time env for the `dev` branch (tracked in git, NON-sensitive only).
# Baked into images by .github/workflows/docker.yml (`Load build-time env file`).
# Only values with a Dockerfile ARG live here (frontend NEXT_PUBLIC_API_URL,
# opencode-server OPENCODE_VERSION). Everything else — DB credentials,
# private keys, JWT material, registry auth, deploy hooks, compose `:?`
# externals (DB connection strings, server credentials, ...) — stays OUTSIDE git
# (repo vars / protected CI stores / external environment). Precedence in CI:
# repo vars > this file. Never add sensitive values here.
NEXT_PUBLIC_API_URL=http://localhost:3100
OPENCODE_VERSION=1.18.32
