# SINGLE SOURCE OF TRUTH — copy to .env and fill locally (never commit .env/secrets).
# Validation rules (zod@4, ERROR vs WARN taxonomy, [env] format, never-log-secrets):
# docs/env-validation.md — enforced by apps/backend/src/env.ts + env.spec.ts.
# Precedence everywhere: shell process.env > .env file > built-in defaults.
# Interpolation: ${VAR} / ${VAR:-default} (dotenv-expand / docker-compose / ecosystem.config.cjs).
# Empty HOSTs fall back to `localhost` in code (backend src/env.ts) and pm2 defaults,
# so the composites below never boot as broken `http://:`.
#
# DEV (local .env): leave APP_BACKEND_HOST empty and either
#   unset APP_BACKEND_SOCKET or remove that line —
#   code fills localhost dev-fallbacks (DB via POSTGRES_*/localhost composition).
#   Compose has no local postgres service: DATABASE_URL is REQUIRED there
#   (fail-fast, external postgres only).
#   OPENCODE_* ships with stand defaults below (0.0.0.0:4096).
# PROD (external env / Dokploy): set DATABASE_URL to the external postgres URL
#   (or set POSTGRES_HOST to the real host, e.g. pg.db.web2bizzz.store,
#   and let DATABASE_URL compose from POSTGRES_* for host-local/PM2 runs —
#   compose itself still requires DATABASE_URL explicitly),
#   and set APP_BACKEND_SOCKET / NEXT_PUBLIC_API_URL to the public backend URL.
# Compose reads a SINGLE docker-compose.yml; there are no
# docker-compose.prod.yml / docker-compose.override.yml files and no env_file —
# every variable below arrives via external environment. No `.env.${NODE_ENV}`
# files are read — do not create them.
#
# Apps envs
APP_BACKEND_PORT=3100
APP_BACKEND_HOST=
APP_BACKEND_PROTOCOL=http
APP_BACKEND_SOCKET=${APP_BACKEND_PROTOCOL}://${APP_BACKEND_HOST}:${APP_BACKEND_PORT}


# OpenCode connection data (stand: `opencode serve` listens on 0.0.0.0:4096 —
# all interfaces. The composed URL keeps 0.0.0.0 verbatim; the backend remaps
# it to 127.0.0.1 for outbound dialing in OpencodeService.dialUrl()).
OPENCODE_HOST=0.0.0.0
OPENCODE_PORT=4096
OPENCODE_PROTOCOL=http
OPENCODE_URL=${OPENCODE_PROTOCOL}://${OPENCODE_HOST}:${OPENCODE_PORT}
# Optional bearer token for the opencode server ('' = unauthenticated).
# Sent as `Authorization: Bearer …` by the sdk reverse-proxy (/api/opencode/*).
# Never logged, never committed — set locally / via secrets only.
# OPENCODE_TOKEN=
# Server password for the opencode service in docker-compose (REQUIRED there —
# compose fail-fasts if unset; host-local `opencode serve` takes it via env too).
# Inside the compose network the backend reaches opencode at
# http://opencode:4096 (compose default) — an explicit OPENCODE_URL above
# overrides it, so leave OPENCODE_* unset for `docker compose up`.
# OPENCODE_SERVER_PASSWORD=

# Per-user OpenCode keys (GET/PUT/DELETE /api/v1/key + GET /api/v1/usage).
# Each user stores their OWN opencode.ai API key; the backend keeps ONLY the
# AES-256-GCM ciphertext (user_opencode_keys table) and proxies usage with the
# per-user Bearer. Plaintext keys are never logged, never returned.
# OPENCODE_KEYS_ENCRYPTION_KEY: server secret for at-rest encryption (≥32 chars,
# REQUIRED for the key endpoints — unset → they answer 500 opencode_keys_unconfigured;
# short → boot ERROR). One key per deploy, no rotation/re-encrypt in this iteration.
# Generate: bun -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))".
# Never log it, never commit it — set locally / via secrets only.
# OPENCODE_KEYS_ENCRYPTION_KEY=
# OPENCODE_BILLING_URL: upstream usage endpoint (GET, per-user Bearer).
# Default https://api.opencode.ai/usage is UNVERIFIED (no public billing path was
# discoverable) — override when the real endpoint is known. Unreachable/bad-shape
# upstream answers 503 EXTERNAL_UNAVAILABLE (Retry-After 30), timeouts 504.
# OPENCODE_BILLING_URL=https://api.opencode.ai/usage

# Postgres — always EXTERNAL (no postgres service in docker-compose).
# Compose requires DATABASE_URL explicitly (fail-fast when unset).
# Host-local / PM2 runs may leave DATABASE_URL unset and let the backend
# compose it from POSTGRES_* (POSTGRES_HOST empty → localhost dev fallback).
POSTGRES_USER=devbox
POSTGRES_PASSWORD=changeme
POSTGRES_DB=devbox
POSTGRES_PORT=5432
POSTGRES_HOST=pg.db.web2bizzz.store

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Security
CORS_ORIGINS=http://localhost:${NEXT_PUBLIC_PORT},http://localhost:8080
REQUEST_TIMEOUT_MS=10000

# Auth (internal accounts: email+password → argon2id + HS256 JWT).
# Secrets ONLY via env — never commit real values, never logged (names only).
# Access: short-lived (JWT_ACCESS_TTL, default 15m). Refresh: rotating,
# single-use jti (JWT_REFRESH_TTL, default 7d, reuse revokes the family).
# Unset secret → ephemeral dev secret (WARN, tokens die on restart).
# Explicit secrets must be ≥ 32 chars. Generate: bun -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))".
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=15m (formats: 15m | 1h | 7d | seconds 60-7776000)
# JWT_REFRESH_TTL=7d
# Legacy x-user-id / ?userId mock identity fallback (dev default unset→true+WARN).
# Set "false" for production (JwtAuthGuard then requires Bearer everywhere).
# AUTH_LEGACY_MOCK_FALLBACK=true

# Organizations: single-use invite-token TTL in seconds (default 86400 = 24h,
# range 60-7776000). No per-invite override — one server-wide policy.
# ORG_INVITE_TTL_SEC=86400

# Upstream retry: idempotent GET + 429/5xx/timeout only (POST runs once;
# backoff base doubles per attempt, capped at max, equal jitter).
# EXTERNAL_RETRY_MAX_ATTEMPTS=3
# EXTERNAL_RETRY_BASE_DELAY_MS=200
# EXTERNAL_RETRY_MAX_DELAY_MS=2000

# Others
LOG_LEVEL=info

# Projects (readonly file browser jail root; defaults to backend cwd when empty)
PROJECTS_ROOT=

# Repos registry + project storage root (organizations layout, no `workspace` segment).
# Layout: REPOS_ROOT/users/<user-uuid>/projects/<project-uuid>/{content,.secrets}
#   + REPOS_ROOT/orgs/<org-uuid>/projects/<project-uuid>/{content,.secrets}
#   (projects create() inits a git repo in content; repos list readdirs content dirs).
# REQUIRED for ALL storage (reads AND writes): REPOS_ROOT is the single unified
# catalog. Empty REPOS_ROOT → boot continues but logs [env] ERROR (storage
# unavailable); POST /api/v1/projects answers 500 (no mkdir, no DB row),
# storage reads (repos list, workspaces tree/submodules, project-files tree,
# clone dest) deny with 503 EXTERNAL_UNAVAILABLE (Retry-After 30); only
# GET /projects + GET /projects/:id surface corrupted/storage-unconfigured.
# No <PROJECTS_ROOT>/repos or <cwd>/repos fallback — never read or created.
# Must exist + be readable when set explicitly, otherwise boot fails fast with [env] REPOS_ROOT.
# REPOS_ROOT=

# GitHub link (optional defaults only — tokens are NEVER stored; link endpoints
# validate owner/repo/branch format and assemble https://github.com URLs)
# GITHUB_OWNER=
# GITHUB_BRANCH=main

# GitHub App (multi-tenant: any user installs the App on their account).
# Flow: GET /api/v1/projects/github/install-url → user installs →
# GET /api/v1/projects/github/callback?installation_id=&setup_action= binds it →
# POST /api/v1/projects/github/webhook (signature-verified) tracks lifecycle →
# GET /api/v1/projects/github/repos resolves the caller's installation.
# App JWT → POST /app/installations/{id}/access_tokens (in-memory per-install
# cache only) → GET /installation/repositories. Required App scopes:
# metadata:read, contents:read. Tokens/private key are NEVER logged or persisted.
# Set APP_ID + PRIVATE_KEY (+ SLUG + WEBHOOK_SECRET for the full flow) to enable;
# empty pair → github endpoints answer 401/503.
# GITHUB_APP_ID=123456
# Preferred: keep the PEM out of env — point at a file (avoids multiline
# quoted PEM breaking dotenv/compose/pm2 parsers). Path wins when set; may be
# absolute or relative to the backend cwd (e.g. ./keys/github-app.pem).
# GITHUB_APP_PRIVATE_KEY_PATH=./keys/github-app.pem
# Fallback: inline key (raw PEM with \n escapes ok, or base64-encoded PEM).
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
#   (raw PEM, \n escapes ok, or base64-encoded PEM)
# GITHUB_APP_SLUG=my-devbox-app (https://github.com/apps/<slug>/installations/new)
# GITHUB_WEBHOOK_SECRET=change-me (must match the App webhook secret; X-Hub-Signature-256)
# GITHUB_API_URL=https://api.github.com (override for GitHub Enterprise)
# Legacy dev fallback (deprecated, single install without the install flow):
# GITHUB_APP_INSTALLATION_ID=789012

# Docker Registry HTTP API v2 (optional — minimal read client: GET /v2/ ping
# + GET /v2/_catalog). Unset DOCKER_REGISTRY_URL → health flag "skipped",
# GET /api/v1/registry/catalog answers 503 EXTERNAL_UNAVAILABLE (Retry-After).
# Boot never stops for the registry: unreachable at startup settles on "down"
# after DOCKER_REGISTRY_RETRY_* backoff (no throw); later success reconnects.
# Auth: DOCKER_REGISTRY_TOKEN (Bearer) wins over the basic
# DOCKER_REGISTRY_USER/PASSWORD pair; a half-set pair warns + goes anonymous.
# Secrets NEVER appear in errors/logs — only key names + this pointer.
# DOCKER_REGISTRY_URL=http://127.0.0.1:5000
# DOCKER_REGISTRY_USER=
# DOCKER_REGISTRY_PASSWORD=
# DOCKER_REGISTRY_TOKEN=
# DOCKER_REGISTRY_TIMEOUT_MS=10000
# DOCKER_REGISTRY_RETRY_MAX_ATTEMPTS=3
# DOCKER_REGISTRY_RETRY_BASE_DELAY_MS=200
# DOCKER_REGISTRY_RETRY_MAX_DELAY_MS=2000

# npm registry observe-only module (selfhosted Verdaccio, optional).
# The module ONLY probes availability (GET /-/ping + status endpoint) — it never
# publishes/installs, so the bun-install NPM_TOKEN wiring below is untouched.
# Unset NPM_REGISTRY_URL → health flag "skipped",
# GET /api/v1/registry/npm/status answers 503 EXTERNAL_UNAVAILABLE (Retry-After).
# Boot never stops for npm: unreachable at startup settles on "down" after
# NPM_REGISTRY_RETRY_* backoff (no throw); later success reconnects.
# Auth priority: NPM_REGISTRY_TOKEN (Bearer) wins; else the
# NPM_REGISTRY_USER/PASSWORD basic pair (Basic) for the closed Verdaccio;
# else anonymous. Legacy NPM_TOKEN is the Bearer fallback when
# NPM_REGISTRY_TOKEN is unset (WARN once, stays used by .npmrc/bunfig for
# installs). A half-set USER/PASSWORD pair warns + goes anonymous.
# 401 (bad credentials) / 403 (forbidden) → health "down", status 503 neutral.
# Scope: observed npm scope for the status payload (default @web2bizz).
# Secrets NEVER appear in errors/logs — only key names + this pointer.
# NPM_REGISTRY_URL=https://npm.registry.web2bizz.team
# NPM_REGISTRY_TOKEN=
# NPM_REGISTRY_USER=
# NPM_REGISTRY_PASSWORD=
# NPM_REGISTRY_SCOPE=@web2bizz
# NPM_REGISTRY_TIMEOUT_MS=10000
# NPM_REGISTRY_RETRY_MAX_ATTEMPTS=3
# NPM_REGISTRY_RETRY_BASE_DELAY_MS=200
# NPM_REGISTRY_RETRY_MAX_DELAY_MS=2000

# Compose publish specs (single docker-compose.yml; whole `host:port` strings).
# Prod defaults bind all interfaces; dev sets loopback values from the shell.
# BACKEND_PUBLISH=3100 (prod default; dev: 127.0.0.1:3100)
# FRONTEND_PUBLISH=8080 (prod default; dev loopback: 127.0.0.1:8080)
# FRONTEND_DEV_PUBLISH=127.0.0.1:3001 (dev-profile server only, loopback by default)
# COMPOSE_PROFILES=dev (enables the frontend-dev service: `build` stage +
# `bun run dev:next` with bind-mounts; prod `docker compose up` ignores it)

# Frontend
NEXT_PUBLIC_PORT=3001
NEXT_PUBLIC_API_URL=${APP_BACKEND_SOCKET}

# Private npm registry (selfhosted Verdaccio: https://npm.registry.web2bizz.team).
# Token ONLY via env — never commit real values (see .npmrc / bunfig.toml
# [install.scopes], both reference ${NPM_TOKEN} / $NPM_TOKEN placeholder).
# Local: export NPM_TOKEN=$(grep -oP '(?<=_authToken=).*' ~/.npmrc | tr -d '\r\n ') or put in .env (ignored).
# CI: secrets.NPM_TOKEN (masked). Docker: --secret id=NPM_TOKEN (never --build-arg).
# Write the secret file with printf '%s' (no trailing newline — a trailing \n
# makes Verdaccio answer 400 inside `docker build`).
# Rotation: reissue in registry UI → update local ~/.npmrc + CI secret, no code change.
# NPM_TOKEN=
#
# Frontend UI kit: @web2bizz/ui pinned exact in apps/frontend/package.json
# (currently 0.25.7 — bump via `bun add @web2bizz/ui@<ver>` in apps/frontend).
# Peer deps: react>=19, react-dom>=19 (frontend is on React 19; do NOT
# downgrade to 18 — the kit's ThemeProvider/components require 19).
# Consumer wiring: `@web2bizz/ui/styles.css` once in app/layout.tsx +
# <ThemeProvider> via src/providers.tsx (mount-guarded for SSR).
# Full registry/auth/publish guide: docs/npm-registry.md.
