# Build-time env for `main` / prod builds (tracked in git, NON-sensitive only).
# Same mechanism as .env.develop (see its header + docker.yml step
# `Load build-time env file`: branch main -> this file, else .env.develop).
# OWNER ACTION REQUIRED: replace CHANGEME below with the real public backend
# URL before any prod image build — CI refuses to bake a CHANGEME value
# (fail-fast guard in docker.yml, no silent placeholder in the bundle).
NEXT_PUBLIC_API_URL=https://CHANGEME.example.com
