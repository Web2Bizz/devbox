# Private scope → selfhosted registry (Verdaccio: https://npm.registry.web2bizz.team).
# Token is NEVER hardcoded here: injected via ${NPM_TOKEN} env
# (local shell / .env / CI secrets.NPM_TOKEN / `docker build --secret`).
# Public (unscoped) packages fall back to the default npm registry.
# Global auth in ~/.npmrc is left untouched — this file is project-level only.
@web2bizz:registry=https://npm.registry.web2bizz.team/
//npm.registry.web2bizz.team/:_authToken=${NPM_TOKEN}
