# Backend has no separate .env source — see ../../.env.example (single source, ${VAR} interpolation).
# Copy root .env.example to ../../.env for local overrides (never commit .env/secrets).
# Precedence: shell process.env > root .env file > built-in defaults.
#
# Resolved keys consumed by apps/backend/src/main.ts via validateEnv() in src/env.ts
# (zod@4 schemas + ConfigModule.forRoot({ validate }) fail-fast, CJS project)
# (all optional unless noted; defaults shown):
#   APP_BACKEND_PORT=3000 (REQUIRED — legacy fallback: PORT; empty → fail-fast)
#   APP_BACKEND_HOST= (empty → dev fallback localhost; never `http://:`)
#   APP_BACKEND_PROTOCOL=http
#   APP_BACKEND_SOCKET=${APP_BACKEND_PROTOCOL}://${APP_BACKEND_HOST}:${APP_BACKEND_PORT}
#   OPENCODE_URL=${OPENCODE_PROTOCOL}://${OPENCODE_HOST}:${OPENCODE_PORT}
#     (в docker-compose дефолт — http://opencode:4096 внутри сети `back`;
#      legacy fallback: OPENCODE_SERVER_URL; empty HOST → localhost, empty PORT → 4096;
#      explicitly broken values fail fast; unreachable upstream → mock fallback, never throws)
#   DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
#     (REQUIRED in docker-compose — fail-fast when unset, always external;
#      host-local/PM2 runs: explicit value wins, else composed from POSTGRES_*
#      with POSTGRES_HOST empty → localhost; unset credentials → pg stub
#      skipped, MVP still boots)
#   CORS_ORIGINS=http://localhost:${NEXT_PUBLIC_PORT},http://localhost:8080
#   REQUEST_TIMEOUT_MS=10000
#   LOG_LEVEL=info
# Secrets (DATABASE_URL, POSTGRES_PASSWORD) are never logged.
# Only create apps/backend/.env for service-local overrides (e.g. remote DATABASE_URL);
# prefer setting values in the root .env so compose + pm2 stay in sync.
