{
  "$schema": "https://swc.rs/docs/configuration/swcrc",
  "sourceMaps": true,
  "jsc": {
    "target": "es2023",
    "parser": {
      "syntax": "typescript",
      "tsx": false,
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "baseUrl": ".",
    "keepClassNames": true
  },
  "module": {
    "type": "commonjs",
    "ignoreDynamic": true
  },
  "exclude": ["node_modules", "dist"]
}
