{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  // Per-app wrapper: all shared settings live in packages/biome-config/biome.json.
  // Only build-output ignores are local (used when `biome lint` runs with cwd here).
  "root": false,
  "extends": ["../../packages/biome-config/biome.json"],
  // Plugin paths resolve from THIS config — shared plugins entry repeated
  // with an app-relative path (Biome 2.5.15: no resolutionKind).
  "plugins": [
    {
      "path": "../../packages/biome-config/plugins/no-literal-args.grit",
      "includes": [
        "**",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/*.e2e.ts",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**",
        // Dev-only CLIs (draft stand + e2e runner): console is their output
        // channel, and their literals sit inside `new Promise(...)` callbacks
        // the GritQL plugin cannot type-distinguish (false positives).
        "!draft-stand/**",
        "!scripts/**"
      ]
    }
  ],
  // Same two dev-only trees: `console.*` is the intended CLI output, not a
  // runtime logger bypass (runtime code still goes through AppLogger).
  "overrides": [
    {
      "includes": ["draft-stand/**", "scripts/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ],
  "files": {
    // Dev-only CLIs are excluded from lint: `console.*` is their output
    // channel, and the GritQL literal plugin cannot type-distinguish their
    // stdlib calls inside `new Promise(...)` callbacks (false positives).
    "includes": [
      "**",
      "!!**/dist/**",
      "!!**/node_modules/**",
      "!!**/coverage/**",
      "!!draft-stand/**",
      "!!scripts/**"
    ]
  }
}
