# DevBox CLI — env example (copy to .env; never commit real keys).
# REPOS_ROOT is required for any @ref (no default, no <cwd>/repos fallback).
REPOS_ROOT=/path/to/repos

# Force the stdout REPL fallback (skip the transparent OpenTUI layer even
# on a TTY). Useful for dumb terminals/CI recordings. Default off (empty).
DEVBOX_NO_TUI=

# Direct cloud chat with the paid Go subscription (default, no serve needed):
# Key source is auth.json ONLY ($HOME/.local/share/opencode/auth.json,
# XDG_DATA_HOME override, JSON {opencode:{key}, opencode-go:{key}} —
# opencode-go.key first). Env key vars are NOT read for the key:
# OPENCODE_API_KEY/JEV_API_KEY below are ignored (kept as commented
# placeholder so old setups don't fail silently).
# Missing → fail-fast missing key in auth.json with path. Never commit a real key.
# OPENCODE_API_KEY= (IGNORED — not read, use /connect in TUI)

# Cloud chat endpoint (documented inference endpoint, see README § Chat).
# Explicit override only (stage/dev); default is the hard-coded
# https://opencode.ai/inference/openai/v1/chat/completions.
OPENCODE_CLOUD_URL=https://opencode.ai/inference/openai/v1/chat/completions

# Optional cloud model id (selection format opencode/<model-id>;
# empty = deepseek-v4.1-flash). Known ids:
# deepseek-v4.1-flash (default), deepseek-v4-pro, deepseek-v4-flash,
# deepseek-v4.1-flash-free (free variant).
# qwen-3-coder-480b is DEPRECATED since 2026-02-06 (upstream 400 Model is
# unavailable) — do not set it.
# jev ("jev-1.13-free") is NOT a chat model (SystemOne choice-only, answers
# the literal "answer") and is rejected for chat — see README § Chat.
OPENCODE_MODEL=

# OPTIONAL serve fallback (default OFF = cloud without serve).
# Set OPENCODE_USE_SERVE=1 to try local serve when cloud fails.
# Start it with: opencode serve --port 4096
# 0.0.0.0 is dialed as 127.0.0.1 (mirrors backend OpencodeService.dialUrl).
OPENCODE_USE_SERVE=
OPENCODE_URL=http://127.0.0.1:4096

# Password of `opencode serve` (fallback only, from the serve log) — if serve
# runs without a password, leave empty (header omitted).
# Alias: OPENCODE_SERVER_PASSWORD. Never commit a real password here.
OPENCODE_TOKEN=
