# DevBox CLI env (no secrets in repo — values only via local .env, never commit real keys).
# REPOS_ROOT — required for any @ref (no default, no <cwd>/repos fallback).
REPOS_ROOT=/path/to/your/repos

# OPENCODE_API_KEY — required for /agent --apply and free-prompt replies.
# Priority: env OPENCODE_API_KEY → fallback auth.json
# ($HOME/.local/share/opencode/auth.json, XDG_DATA_HOME override,
# JSON {opencode:{key}, opencode-go:{key}} — .opencode-go.key || .opencode.key).
# Get the key from the OpenCode console (same as /connect); without it the CLI
# stays in dry-run and fails fast with missing OPENCODE_API_KEY.
OPENCODE_API_KEY=

# Optional override of the OpenCode Cloud base URL (default is the hard-coded
# OPENCODE_API_BASE_URL in src/agents/opencode.ts, Cloud API — user-approved).
# NOT api.opencode.ai (catch-all, 200 Not Found) — real Cloud host is
# opencode.ai (see backend opencode-billing.service.ts live-probe doc).
# The inference endpoint is always built as new URL(OPENCODE_CHAT_PATH, base)
# where OPENCODE_CHAT_PATH is the proven v2 systemone path
# /inference/systemone/v1/systemone (see src/agents/opencode.ts; v2 docs
# https://opencode.ai/v2/docs/api have no chat surface — never /v1/chat,
# which is a 404 HTML catch-all). Point at a local base for offline/dev.
# OPENCODE_API_BASE_URL=https://opencode.ai
# Legacy alias (kept for compat, same base semantics):
# OPENCODE_BASE_URL=https://opencode.ai
