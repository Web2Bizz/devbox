# Required backend base URL. The CLI uses /api/opencode for OpenCode-compatible
# chat and /api/v1/health for the home-screen online/offline indicator.
RUSH_CODE_BACKEND_URL=https://backend.example.com

# Optional OpenCode model override. Use provider/model to select an explicit
# provider; unset to use the backend's default model.
OPENCODE_MODEL=

# Required only when resolving @refs.
REPOS_ROOT=/path/to/repos
