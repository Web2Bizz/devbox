# DevBox CLI — env example (copy to .env; never commit real keys).
# REPOS_ROOT is required for any @ref (no default, no <cwd>/repos fallback).
REPOS_ROOT=/path/to/repos

# OpenCode Go key (only for cloud systemone choice-classification):
# env OPENCODE_API_KEY (fallback JEV_API_KEY) → fallback auth.json
# ($HOME/.local/share/opencode/auth.json, XDG_DATA_HOME override).
OPENCODE_API_KEY=

# Local serve for free-text chat with the paid Go subscription
# (default http://127.0.0.1:4096; override only to point at a running serve).
# Start it with: opencode serve --port 4096
OPENCODE_URL=http://127.0.0.1:4096

# Password of `opencode serve` (from the serve log) — if serve runs without
# a password, leave empty.
OPENCODE_TOKEN=
