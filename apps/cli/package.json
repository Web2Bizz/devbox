{
  "name": "@rush-code/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Rush Code CLI in opencode style — interactive REPL with @file refs and /agent allowlist (dry-run by default)",
  "type": "module",
  "scripts": {
    "cli": "bun src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json && biome lint .",
    "test": "bun test --isolate --pass-with-no-tests src"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "@opentui/core": "0.6.8",
    "@opentui/react": "0.6.8",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^19.2.0",
    "bun-types": "^1.4.2",
    "typescript": "^6.0.3"
  }
}
