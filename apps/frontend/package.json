{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Devbox frontend (Next.js App Router + React + TypeScript, migrated from Vite)",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p ${NEXT_PUBLIC_PORT:-3001}",
    "dev:next": "next dev --turbopack -p ${NEXT_PUBLIC_PORT:-3001}",
    "build": "next build --turbopack",
    "build:next": "next build --turbopack",
    "start": "bun .next/standalone/apps/frontend/server.js",
    "start:next": "bun .next/standalone/apps/frontend/server.js",
    "lint": "tsc --noEmit -p tsconfig.json && biome lint .",
    "test": "bun test --isolate --pass-with-no-tests app src"
  },
  "dependencies": {
    "@devbox/contracts": "workspace:*",
    "@hookform/resolvers": "5.9.1",
    "@opencode-ai/sdk": "1.18.33",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "3.14.13",
    "@web2bizz/ui": "0.26.0",
    "next": "^16.3.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.7.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.4.2",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2"
  }
}
