{
  "name": "@opencode-ai/mobile",
  "version": "0.6.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "check:versions": "node scripts/check-version-parity.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:bump:major": "node scripts/bump-version.mjs --major",
    "version:bump:dry": "node scripts/bump-version.mjs --dry-run",
    "test": "node --test 'src/**/*.test.ts' 'packages/uikit/src/**/*.test.ts' 'scripts/*.test.mjs'"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "~0.3.2",
    "@react-navigation/native": "^7.0.14",
    "@tanstack/react-query": "^5.62.0",
    "@web2bizz/ui-native": "file:packages/uikit",
    "expo": "^57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-network": "^57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-speech-recognition": "^57.1.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-i18next": "^17.0.10",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-marked": "8.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": []
    },
    "autolinking": {
      "buildFromSource": [
        ".*"
      ]
    }
  }
}
