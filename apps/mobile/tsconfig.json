{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/utils/*": ["./src/shared/utils/*"],
      "@/hooks/*": ["./src/shared/hooks/*"],
      "@/api/*": ["./src/shared/api/*"],
      "@/stores/*": ["./src/shared/stores/*"],
      "@/shared/*": ["./src/shared/*"],
      "@shared/*": ["./src/shared/*"],
      "@utils/*": ["./src/shared/utils/*"],
      "@hooks/*": ["./src/shared/hooks/*"],
      "@api/*": ["./src/shared/api/*"],
      "@stores/*": ["./src/shared/stores/*"],
      "@app/*": ["./app/*"],
      "@web2bizz/ui-native": ["./packages/uikit/src/index.ts"],
      "@web2bizz/ui-native/*": ["./packages/uikit/src/*"],
      // TODO: deprecated alias @opencode-ai/uikit — удалить через 1 релиз (rename → @web2bizz/ui-native).
      "@opencode-ai/uikit": ["./packages/uikit/src/index.ts"],
      "@opencode-ai/uikit/*": ["./packages/uikit/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "tests/fixtures/**", "website"]
}
