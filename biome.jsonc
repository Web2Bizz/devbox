{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  // NOTE (lint-only rollout): only `biome lint` is wired into the per-app
  // `lint` scripts (tsc --noEmit && biome lint .). The formatter
  // (`biome format`) is deliberately NOT enforced — turning it on would
  // reformat the whole tree in one go. Revisit formatting as a separate,
  // dedicated change. (This file is JSONC so these comments are legal;
  // Biome 2.x parses plain biome.json as strict JSON.)
  //
  // Shared settings live in packages/biome-config/biome.json (single source).
  // This root file only adds monorepo scope (files.includes) and VCS
  // integration. Per-app exceptions live in each app's own biome.jsonc
  // (files under apps/<name>/ are governed by the nearest config, and
  // shared override globs resolve from each extending package directory).
  "extends": ["./packages/biome-config/biome.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // Single root binary for the monorepo: only the bun-workspace apps are
    // in scope (apps/mobile is a separate npm project with its own setup).
    // node_modules/ is always ignored by Biome; dist/ and .next/ are also
    // git-ignored (picked up via useIgnoreFile above) but force-ignored
    // here as well, plus coverage/ which is NOT git-ignored — built output
    // and reports must never be linted even when present on disk.
    "includes": [
      "apps/backend/**",
      "apps/frontend/**",
      "apps/cli/**",
      "packages/contracts/**",
      "packages/biome-config/**",
      // Belt-and-braces: the allowlist above already scopes mobile out
      // (separate npm project, never linted by this config) — this negation
      // keeps it out even if the allowlist is ever broadened to apps/**.
      "!!apps/mobile/**",
      "!!**/dist/**",
      "!!**/.next/**",
      "!!**/node_modules/**",
      "!!**/coverage/**"
    ]
  }
}
