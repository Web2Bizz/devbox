{
  "name": "devbox",
  "version": "0.1.0",
  "private": true,
  "description": "DevBox — monorepo (apps/backend NestJS API + apps/frontend Next.js + apps/mobile Expo + postgres)",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/cli",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "bun --filter @devbox/contracts build && (pm2 start ecosystem.config.cjs --update-env || pm2 restart ecosystem.config.cjs --update-env)",
    "dev:shutdown": "pm2 delete ecosystem.config.cjs || true; pm2 kill || true",
    "dev:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "dev:logs": "pm2 logs",
    "dev:backend": "bun --filter @devbox/contracts build && bun --filter backend dev",
    "dev:frontend": "bun --filter @devbox/contracts build && bun --filter frontend dev",
    "dev:pm2": "pm2 start ecosystem.config.cjs",
    "dev:pm2:logs": "pm2 logs",
    "dev:pm2:stop": "pm2 delete ecosystem.config.cjs",
    "dev:pm2:restart": "pm2 restart ecosystem.config.cjs",
    "build": "bunx nx run-many -t build",
    "build:backend": "bunx nx run backend:build",
    "build:frontend": "bunx nx run frontend:build",
    "build:affected": "bunx nx affected -t build",
    "lint": "bunx nx run-many -t lint",
    "lint:affected": "bunx nx affected -t lint",
    "test": "bunx nx run-many -t test",
    "test:affected": "bunx nx affected -t test",
    "graph": "bunx nx graph"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@web2bizz/scaffold": "^0.1.7",
    "nx": "^23.3.0",
    "pm2": "^6.0.14"
  }
}
