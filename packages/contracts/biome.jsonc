{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  // Per-package wrapper: all shared settings live in ../biome-config/biome.json.
  // Only build-output ignores are local (used when `biome lint` runs with cwd here).
  "root": false,
  "extends": ["../biome-config/biome.json"],
  // Plugin paths resolve from THIS config — shared plugins entry repeated
  // with a package-relative path (Biome 2.5.15: no resolutionKind).
  "plugins": [
    {
      "path": "../biome-config/plugins/no-literal-args.grit",
      "includes": [
        "**",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/*.e2e.ts",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**"
      ]
    }
  ],
  "files": {
    "includes": ["**", "!!**/dist/**", "!!**/node_modules/**", "!!**/coverage/**"]
  }
}
