{
  "name": "@devbox/contracts",
  "version": "0.1.0",
  "description": "Shared DevBox wire contracts — entity types + zod v4 boundary schemas. Single source of truth for backend/frontend; mirrors contracts/openapi.yaml.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --isolate --pass-with-no-tests src"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2"
  }
}
